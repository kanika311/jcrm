generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---
enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PaymentState {
  PENDING
  COMPLETED
  FAILED
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
}

enum TeamApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANDIDATE
  STUDENT
  PLACED
  ALUMNI
}

// --- MODELS ---

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  fullName      String?   @map("full_name")
  name          String?
  email         String    @unique
  phoneNumber   String?   @map("phone_number")
  emailVerified DateTime? @map("email_verified")
  image         String?
  passwordHash  String?   @map("password_hash")
  role          UserRole  @default(STUDENT) @map("role")
  isBlocked     Boolean   @default(false) @map("is_blocked")
  createdAt     DateTime  @default(now()) @map("created_at")

  // Relationships
  profile          UserProfile?
  courses          Course[]           @relation("FacultyCourses")
  enrollments      Enrollment[]
  platformSettings PlatformSettings[]
  accounts         Account[]
  sessions         Session[]
  
  insightPosts     InsightPost[]
  insightLikes     InsightLike[]
  insightComments  InsightComment[]
  facultyAssignments Assignment[] @relation("FacultyAssignments")
  assignmentSubmissions AssignmentSubmission[] @relation("StudentSubmissions")

  @@index([role])
  @@map("Users")
}

model DirectMessage {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  threadKey  String   @map("thread_key")
  senderRole String   @map("sender_role")
  senderId   String   @map("sender_id")
  text       String
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([threadKey])
  @@map("direct_messages")
}

model UserProfile {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @unique @map("user_id") @db.ObjectId
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  lifeStage       String?  @map("life_stage") // e.g., 'Student', 'Professional'
  organization    String? // College or Company
  degree          String?
  experienceYears Int?     @map("experience_years")
  techStack       String[] @map("tech_stack")
  
  country         String?
  state           String?
  city            String?
  pincode         String?
  languages       String[] @map("languages")
  
  bio             String?
  linkedinUrl     String?  @map("linkedin_url")
  githubUrl       String?  @map("github_url")
  portfolioUrl    String?  @map("portfolio_url")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("UserProfiles")
}

model Course {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  facultyId    String       @map("faculty_id") @db.ObjectId
  title        String
  description  String
  price        Float
  status       CourseStatus @default(PUBLISHED) @map("status")
  level          String?      @default("Beginner")
  tags           String[]     @default([])
  badge          String?
  image          String?
  instructor     String?
  instructorRole String?      @default("Senior Tech Instructor") @map("instructor_role")
  duration       String?      @default("3 Months • 120 Hours")
  whatYouLearn   String[]     @default([]) @map("what_you_learn")
  curriculum     Json?
  createdAt      DateTime     @default(now()) @map("created_at")

  // Relationships
  faculty     User         @relation("FacultyCourses", fields: [facultyId], references: [id])
  lessons     Lesson[]
  enrollments Enrollment[]
  assignments Assignment[]

  @@index([facultyId])
  @@index([status])
  @@map("Courses")
}

model Lesson {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  courseId   String @map("course_id") @db.ObjectId
  title      String
  videoKey   String @map("video_key")
  orderIndex Int    @map("order_index")

  // Relationships
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("Lessons")
}

model Enrollment {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  studentId       String       @map("student_id") @db.ObjectId
  courseId        String       @map("course_id") @db.ObjectId
  transactionId   String?      @unique @map("transaction_id")
  paymentStatus   PaymentState @map("payment_status")
  progressPercent Int          @default(0) @map("progress_percent")
  enrolledAt      DateTime     @default(now()) @map("enrolled_at")

  // Relationships
  student User   @relation(fields: [studentId], references: [id])
  course  Course @relation(fields: [courseId], references: [id])

  // A student can only enroll in a specific course once
  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@map("Enrollments")
}

enum AssignmentWorkStatus {
  PENDING
  SUBMITTED
  GRADED
}

model Assignment {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  courseId    String    @map("course_id") @db.ObjectId
  facultyId   String    @map("faculty_id") @db.ObjectId
  title       String
  description String    @default("")
  dueDate     DateTime? @map("due_date")
  createdAt   DateTime  @default(now()) @map("created_at")

  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  faculty     User      @relation("FacultyAssignments", fields: [facultyId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]

  @@index([courseId])
  @@index([facultyId])
  @@map("assignments")
}

model AssignmentSubmission {
  id           String               @id @default(auto()) @map("_id") @db.ObjectId
  assignmentId String               @map("assignment_id") @db.ObjectId
  studentId    String               @map("student_id") @db.ObjectId
  status       AssignmentWorkStatus @default(SUBMITTED)
  content      String?
  grade        String?
  feedback     String?
  submittedAt  DateTime             @default(now()) @map("submitted_at")

  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      User       @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@map("assignment_submissions")
}

model Testimonial {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  studentName String  @map("student_name")
  reviewText  String  @map("review_text")
  rating      Int
  isPublished Boolean @default(false) @map("is_published")

  @@map("Testimonials")
}

model PlatformSettings {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  themeConfig   Json   @map("theme_config")
  globalContent Json   @map("global_content")
  footerLinks   Json   @map("footer_links")
  lastUpdatedBy String @map("last_updated_by") @db.ObjectId

  // Relationships
  updatedBy User @relation(fields: [lastUpdatedBy], references: [id])

  @@map("Platform_Settings")
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @map("user_id") @db.ObjectId
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model SiteContent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  pageId    String   @unique @map("page_id") // e.g., 'public-home', 'student-dashboard'
  category  String   // 'public', 'student', 'faculty'
  content   Json     // Dynamic payload for this page
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_content")
}

model OtpCode {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String?
  phone     String?
  code      String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([phone])
  @@map("otp_codes")
}

model CareerGuidanceForm {
  id                     String     @id @default(auto()) @map("_id") @db.ObjectId
  firstName              String
  lastName               String
  email                  String
  phone                  String
  location               String
  degree                 String
  university             String
  graduationYear         String
  shortTermGoal          String
  longTermGoal           String
  weaknesses             String     // CSV
  strengths              String     // CSV
  hobbies                String
  remarkableAchievements String
  status                 LeadStatus @default(NEW)
  createdAt              DateTime   @default(now()) @map("created_at")

  @@map("career_guidance_forms")
}

model ContactMessage {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  firstName String
  lastName  String
  email     String
  phone     String?
  subject   String
  message   String
  source    String?
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now()) @map("created_at")

  @@map("contact_messages")
}

model InsightPost {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  authorId    String   @map("author_id") @db.ObjectId
  title       String
  content     String?
  imageUrl    String?  @map("image_url")
  videoUrl    String?  @map("video_url")
  codeSnippet String?  @map("code_snippet")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes     InsightLike[]
  comments  InsightComment[]

  @@index([authorId])
  @@map("insight_posts")
}

model InsightLike {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  postId    String   @map("post_id") @db.ObjectId
  userId    String   @map("user_id") @db.ObjectId
  createdAt DateTime @default(now()) @map("created_at")

  post      InsightPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("insight_likes")
}

model InsightComment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  postId    String   @map("post_id") @db.ObjectId
  authorId  String   @map("author_id") @db.ObjectId
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  post      InsightPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([authorId])
  @@map("insight_comments")
}

model TeamMember {
  id          String             @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String
  phone       String?
  role        String             @default("Software Engineering Intern")
  department  String?
  image       String?
  city        String?
  state       String?
  country     String?            @default("India")
  pinCode     String?            @map("pin_code")
  dateOfBirth String?            @map("date_of_birth")
  college     String?
  education   String?
  experience  String?            @default("Fresher / Intern")
  skills      String[]           @default([])
  bio         String?
  company     String?
  status      TeamApprovalStatus @default(CANDIDATE)
  isVerified  Boolean            @default(true) @map("is_verified")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@index([status])
  @@map("team_members")
}

model ErpSolution {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  category     String
  badge        String?
  modulesCount Int      @default(12) @map("modules_count")
  roiMetric    String?  @map("roi_metric")
  image        String?
  description  String
  modules      String[] @default([])
  demoUrl      String?  @map("demo_url")
  price        String?  @default("Custom Enterprise Quote")
  status       String   @default("PUBLISHED")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([status])
  @@map("erp_solutions")
}